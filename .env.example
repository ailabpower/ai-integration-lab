# Copy to .env.local and fill in. Never commit .env.local.
# The same variables go into Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# https://platform.openai.com/api-keys (used for embeddings and the OpenAI chat option)
OPENAI_API_KEY=
# https://platform.claude.com (Claude chat option, and the eval judge)
ANTHROPIC_API_KEY=

# Defaults are fine; change only if you know why.
AI_PROVIDER=anthropic
OPENAI_CHAT_MODEL=gpt-5-mini
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
EMBEDDING_MODEL=text-embedding-3-small

# HubSpot → Settings → Integrations → Private apps (lead agent demo only). Use a demo account, never one with real customers.
HUBSPOT_ACCESS_TOKEN=

# Public demo protection
RATE_LIMIT_PER_HOUR=15
DAILY_COST_CAP_USD=0.30
# Any random string of 16+ characters, e.g. from: node -e "console.log(crypto.randomUUID())"
IP_HASH_SALT=
# Vercel sends this as a Bearer token to the cron route; any random string of 16+ characters
CRON_SECRET=
